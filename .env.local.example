# Copy this file to `.env.local` and fill in the values.
# .env.local is git-ignored by default — do NOT commit real keys.

# Required for /api/analyze and /api/fit. Get a free key at:
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Optional. Without this, GitHub allows 60 unauthenticated requests/hour.
# Adding a token raises the limit to 5,000/hour, which is safer for demo prep.
# Create a fine-grained token with **public repositories, read-only** scope.
GITHUB_TOKEN=

# Optional. Defaults to gemini-2.5-flash (free tier, generous limits).
GEMINI_MODEL=gemini-2.5-flash

# Optional. Enables "Continue with Google" on /login and /register.
# Redirect URI: http://localhost:3000/api/auth/callback/google (and your prod host).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
